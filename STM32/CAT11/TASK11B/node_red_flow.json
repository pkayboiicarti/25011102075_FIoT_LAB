[
  {
    "id": "cat11-tab",
    "type": "tab",
    "label": "STM32 HTTP Client (CAT11)",
    "disabled": false
  },
  {
    "id": "inject-poll",
    "type": "inject",
    "z": "cat11-tab",
    "name": "Poll STM32 HTTP Server",
    "props": [{ "p": "payload" }],
    "repeat": "5",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 180,
    "y": 140,
    "wires": [["http-req"]]
  },
  {
    "id": "http-req",
    "type": "http request",
    "z": "cat11-tab",
    "name": "GET ESP8266 Server",
    "method": "GET",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://192.168.1.105/",
    "x": 450,
    "y": 140,
    "wires": [["dbg-out"]]
  },
  {
    "id": "dbg-out",
    "type": "debug",
    "z": "cat11-tab",
    "name": "HTTP Response",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "x": 700,
    "y": 140,
    "wires": []
  }
]
