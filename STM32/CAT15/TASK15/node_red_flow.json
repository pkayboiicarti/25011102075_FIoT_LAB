  {
    "id": "fn_build_owm_req",
    "type": "function",
    "z": "bme280_tab",
    "name": "Format OpenWeatherMap URL",
    "func": "const city = msg.city || \"Chennai\";\nconst key = msg.apiKey || \"YOUR_OPENWEATHERMAP_API_KEY\";\n\n// Set URL to OpenWeatherMap 2.5 REST API with metric units\nmsg.url = \"https://api.openweathermap.org/data/2.5/weather?q=\" + encodeURIComponent(city) + \"&appid=\" + encodeURIComponent(key) + \"&units=metric\";\nmsg.method = \"GET\";\nreturn msg;",
    "outputs": 1,
    "x": 480,
    "y": 700,
    "wires": [
