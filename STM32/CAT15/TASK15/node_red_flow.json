  {
    "id": "fn_predictor",
    "type": "function",
    "z": "bme280_tab",
    "name": "Dynamic Analytics & Region Predictor",
    "func": "let data = msg.payload;\n\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch(e) {\n        let tMatch = data.match(/T[:=]\\s*([0-9.]+)/i);\n        let hMatch = data.match(/H[:=]\\s*([0-9.]+)/i);\n        let pMatch = data.match(/P[:=]\\s*([0-9.]+)/i);\n        data = {\n            temperature: tMatch ? parseFloat(tMatch[1]) : 24.33,\n            humidity: hMatch ? parseFloat(hMatch[1]) : 64.75,\n            pressure: pMatch ? parseFloat(pMatch[1]) : 1012.47\n        };\n    }\n}\n\nlet temp = parseFloat(data.temperature !== undefined ? data.temperature : 24.33);\nlet hum = parseFloat(data.humidity !== undefined ? data.humidity : 64.75);\nlet pres = parseFloat(data.pressure !== undefined ? data.pressure : 1012.47);\n\n// International Barometric Formula for Altitude (m)\nlet altitude = 44330.0 * (1.0 - Math.pow(pres / 1013.25, 0.190295));\nlet altRound = Math.round(altitude);\n\n// Dynamic Thermal Condition (>26\u00b0C Hot / <24\u00b0C Cold)\nlet thermalState = \"\";\nlet thermalClass = \"\";\nif (temp > 26.0) {\n    let diff = (temp - 26.0).toFixed(1);\n    thermalState = `\ud83d\udd25 WARM / HOT: ${temp.toFixed(1)} \u00b0C (+${diff}\u00b0C above 26\u00b0C)`;\n    thermalClass = \"hot\";\n} else if (temp < 24.0) {\n    let diff = (24.0 - temp).toFixed(1);\n    thermalState = `\u2744\ufe0f TOO COLD: ${temp.toFixed(1)} \u00b0C (-${diff}\u00b0C below 24\u00b0C)`;\n    thermalClass = \"cold\";\n} else {\n    thermalState = `\ud83c\udf3f OPTIMAL / COMFORTABLE: ${temp.toFixed(1)} \u00b0C (24\u00b0C - 26\u00b0C)`;\n    thermalClass = \"optimal\";\n}\n\n// Altitude Classification\nlet altState = \"\";\nif (altRound < 200) {\n    altState = `\ud83c\udf0a Sea Level / Lowland (~${altRound} m)`;\n} else if (altRound <= 800) {\n    altState = `\ud83c\udf3e Plateau / Midland (~${altRound} m)`;\n} else {\n    altState = `\u26f0\ufe0f Mountain Hill Station (~${altRound} m)`;\n}\n\n// Moisture State\nlet moistState = \"\";\nif (hum < 30.0) {\n    moistState = `\ud83c\udf35 Dry / Arid (${hum.toFixed(1)} %)`;\n} else if (hum <= 60.0) {\n    moistState = `\ud83d\udca7 Comfortable (${hum.toFixed(1)} %)`;\n} else {\n    moistState = `\ud83c\udf27\ufe0f Humid / Damp (${hum.toFixed(1)} %)`;\n}\n\n// Regional Climate Synthesis\nlet synthesis = \"\";\nif (altRound >= 800) {\n    synthesis = `\ud83c\udfd4\ufe0f High-Altitude Hill Station: ${temp < 20 ? 'Crisp & Cold' : 'Temperate Alpine'} (${temp.toFixed(1)} \u00b0C, ${altRound} m, ${hum.toFixed(1)}% RH)`;\n} else if (thermalClass === \"hot\") {\n    synthesis = hum > 60 ? `\u2600\ufe0f Tropical Humid Plain: Increasing Heat & Sweltering (${temp.toFixed(1)} \u00b0C)` : `\ud83c\udfdc\ufe0f Warm Subtropical Basin: Arid Heat (${temp.toFixed(1)} \u00b0C)`;\n} else if (thermalClass === \"cold\") {\n    synthesis = `\u2744\ufe0f Chilly Lowland Plain: Too Cold (${temp.toFixed(1)} \u00b0C) at Sea Level (~${altRound} m).`;\n} else {\n    synthesis = `\ud83c\udf3f Pleasant Temperate Plain: Ideal Comfort Band (${temp.toFixed(1)} \u00b0C, ${hum.toFixed(1)}% RH).`;\n}\n\n// 13 Distinct Output Messages\nlet m1_synthesis   = { payload: synthesis };\nlet m2_thermal     = { payload: thermalState };\nlet m3_altitude    = { payload: altState };\nlet m4_moisture    = { payload: moistState };\nlet m5_chart_t     = { payload: temp };\nlet m6_chart_h     = { payload: hum };\nlet m7_chart_p     = { payload: pres };\nlet m8_gauge_t     = { payload: temp };\nlet m9_gauge_h     = { payload: hum };\nlet m10_gauge_p    = { payload: pres };\nlet m11_disp_t     = { payload: temp.toFixed(2) };\nlet m12_disp_h     = { payload: hum.toFixed(2) };\nlet m13_disp_p     = { payload: pres.toFixed(2) };\n\nreturn [\n    m1_synthesis,\n    m2_thermal,\n    m3_altitude,\n    m4_moisture,\n    m5_chart_t,\n    m6_chart_h,\n    m7_chart_p,\n    m8_gauge_t,\n    m9_gauge_h,\n    m10_gauge_p,\n    m11_disp_t,\n    m12_disp_h,\n    m13_disp_p\n];",
    "outputs": 13,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 280,
    "wires": [
      [
        "ui_synthesis"
      ],
      [
        "ui_thermal"
      ],
      [
        "ui_altitude"
      ],
