  {
    "id": "node_analytics_fn",
    "type": "function",
    "z": "bme280_tab",
    "name": "Dynamic Analytics & Region Predictor",
    "func": "// Parse incoming payload\nlet data = msg.payload;\nif (typeof data === \"string\") {\n    try {\n        data = JSON.parse(data);\n    } catch(e) {\n        node.error(\"Invalid JSON telemetry\", msg);\n        return null;\n    }\n}\n\nif (!data || data.temperature === undefined || data.pressure === undefined || data.humidity === undefined) {\n    return null;\n}\n\nconst temp = Number(data.temperature);\nconst pres = Number(data.pressure);\nconst hum = Number(data.humidity);\n\n// Barometric altitude calculation (Hypsometric equation relative to sea-level 1013.25 hPa)\nconst alt = Math.round(44330 * (1 - Math.pow(pres / 1013.25, 0.19029495718)));\n\n// 1. Dynamic Thermal Condition\nlet thermal_card = \"\";\nlet thermal_tag = \"\";\nif (temp > 26.0) {\n    const diff = (temp - 26.0).toFixed(1);\n    thermal_card = \"\ud83d\udd25 HOT: \" + temp.toFixed(1) + \" \u00b0C (+\" + diff + \"\u00b0C above 26\u00b0C)\";\n    thermal_tag = \"Hot\";\n} else if (temp < 24.0) {\n    const diff = (24.0 - temp).toFixed(1);\n    thermal_card = \"\u2744\ufe0f TOO COLD: \" + temp.toFixed(1) + \" \u00b0C (-\" + diff + \"\u00b0C below 24\u00b0C)\";\n    thermal_tag = \"Too Cold\";\n} else {\n    thermal_card = \"\ud83c\udf3f COMFORTABLE: \" + temp.toFixed(1) + \" \u00b0C (Optimum range 24-26\u00b0C)\";\n    thermal_tag = \"Comfortable\";\n}\n\n// 2. Altitude Classification\nlet alt_card = \"\";\nlet alt_tag = \"\";\nif (pres < 900.0) {\n    alt_card = \"\u26f0\ufe0f High Mountain / Alpine Peak (~\" + alt + \" m)\";\n    alt_tag = \"High Mountain\";\n} else if (pres < 980.0) {\n    alt_card = \"\ud83c\udf32 Elevated Plateau / Foothill (~\" + alt + \" m)\";\n    alt_tag = \"Plateau\";\n} else {\n    alt_card = \"\ud83c\udf0a Sea Level / Lowland (~\" + alt + \" m)\";\n    alt_tag = \"Sea Level\";\n}\n\n// 3. Moisture State Card\nlet moist_card = \"\";\nif (hum > 70.0) {\n    moist_card = \"\ud83c\udf27\ufe0f High Moisture / Humid (\" + hum.toFixed(1) + \" %)\";\n} else if (hum < 40.0) {\n    moist_card = \"\ud83c\udfdc\ufe0f Arid / Dry (\" + hum.toFixed(1) + \" %)\";\n} else {\n    moist_card = \"\ud83d\udca7 Comfortable (\" + hum.toFixed(1) + \" %)\";\n}\n\n// 4. Regional Climate Synthesis\nlet climate_synthesis = \"\";\nif (alt_tag === \"High Mountain\") {\n    climate_synthesis = \"\u26f0\ufe0f Alpine Highland: \" + thermal_tag + \" (\" + temp.toFixed(1) + \" \u00b0C) at Elevation (~\" + alt + \" m).\";\n} else if (temp > 26.0) {\n    climate_synthesis = \"\u2600\ufe0f Warm Tropical Lowland: Hot (\" + temp.toFixed(1) + \" \u00b0C) at Sea Level (~\" + alt + \" m).\";\n} else if (temp < 24.0) {\n    climate_synthesis = \"\u2744\ufe0f Chilly Lowland Plain: Too Cold (\" + temp.toFixed(1) + \" \u00b0C) at Sea Level (~\" + alt + \" m).\";\n} else {\n    climate_synthesis = \"\ud83c\udf3f Mild Maritime Lowland: Comfortable (\" + temp.toFixed(1) + \" \u00b0C) at Sea Level (~\" + alt + \" m).\";\n}\n\n// Save latest sensor values in flow context for OpenWeatherMap delta comparison\nflow.set(\"last_bme\", {\n    temp: temp,\n    pres: pres,\n    hum: hum,\n    alt: alt,\n    timestamp: Date.now()\n});\n\n// Prepare 13 distinct message streams matching the Node-RED flow diagram\nreturn [\n    { payload: climate_synthesis },                // 1: Regional Climate Prediction\n    { payload: thermal_card },                     // 2: Thermal State Card\n    { payload: alt_card },                         // 3: Altitude Prediction Card\n    { payload: moist_card },                       // 4: Moisture State Card\n    { payload: temp },                             // 5: Real-time Temperature Chart\n    { payload: hum },                              // 6: Real-time Humidity Chart\n    { payload: pres },                             // 7: Real-time Pressure Chart\n    { payload: temp },                             // 8: Temperature Gauge\n    { payload: hum },                              // 9: Humidity Gauge\n    { payload: pres },                             // 10: Pressure Gauge\n    { payload: temp.toFixed(2) + \" \u00b0C\" },          // 11: Temperature Display Text\n    { payload: hum.toFixed(2) + \" %RH\" },          // 12: Humidity Display Text\n    { payload: pres.toFixed(2) + \" hPa\" }          // 13: Pressure Display Text\n];",
    "outputs": 13,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 280,
    "wires": [
      [
        "ui_region_pred"
      ],
      [
        "ui_thermal_card"
      ],
      [
        "ui_alt_card"
      ],
      [
        "ui_moisture_card"
      ],
      [
        "ui_chart_temp"
      ],
