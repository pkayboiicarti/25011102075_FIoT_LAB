  {
    "id": "fn_parse_owm",
    "type": "function",
    "z": "bme280_tab",
    "name": "OpenWeatherMap Analytics & Sensor Delta",
    "func": "const owm = msg.payload;\n\n// Validate OpenWeatherMap response\nif (!owm || !owm.main) {\n    return [\n        { payload: \"\u26a0\ufe0f OpenWeatherMap API Key Pending / Rate Limited. Use the Simulation button to test!\" },\n        { payload: \"Awaiting valid API response...\" }\n    ];\n}\n\nconst cloud_temp = Number(owm.main.temp);\nconst cloud_pres = Number(owm.main.pressure);\nconst cloud_hum = Number(owm.main.humidity);\nconst city = owm.name + \", \" + (owm.sys ? owm.sys.country : \"\");\nconst desc = owm.weather && owm.weather[0] ? owm.weather[0].description : \"Clear\";\n\n// Retrieve latest real-time physical BME280 sensor values\nconst sensor = flow.get(\"sensor_data\") || {\n    temperature: 24.33,\n    pressure: 1012.47,\n    humidity: 64.75,\n    time: \"Latest\"\n};\n\n// Compute real-time microclimate delta (Local Sensor vs Cloud Truth)\nconst delta_temp = (sensor.temperature - cloud_temp).toFixed(2);\nconst delta_hum = (sensor.humidity - cloud_hum).toFixed(2);\nconst delta_pres = (sensor.pressure - cloud_pres).toFixed(2);\n\nconst signT = delta_temp >= 0 ? \"+\" : \"\";\nconst signH = delta_hum >= 0 ? \"+\" : \"\";\nconst signP = delta_pres >= 0 ? \"+\" : \"\";\n\nconst owm_summary = \"\ud83c\udf0d <b>\" + city + \" (Cloud):</b> \" + cloud_temp.toFixed(1) + \" \u00b0C | \" + cloud_hum.toFixed(1) + \" %RH | \" + cloud_pres.toFixed(1) + \" hPa (\" + desc + \")\";\n\nconst delta_card = \"<div style='font-family:monospace; line-height:1.7;'>\" +\n    \"\ud83d\udce1 <b>Local BME280 Sensor:</b> \" + sensor.temperature.toFixed(2) + \" \u00b0C, \" + sensor.humidity.toFixed(2) + \" %, \" + sensor.pressure.toFixed(2) + \" hPa<br/>\" +\n    \"\u2601\ufe0f <b>OpenWeatherMap Ground:</b> \" + cloud_temp.toFixed(2) + \" \u00b0C, \" + cloud_hum.toFixed(2) + \" %, \" + cloud_pres.toFixed(2) + \" hPa<br/>\" +\n    \"\u2696\ufe0f <b>Real-Time Calibration Delta:</b> \" +\n    \"<span style='color:\" + (Math.abs(delta_temp) > 3 ? \"#e11d48\" : \"#16a34a\") + \";'>\u0394T: \" + signT + delta_temp + \" \u00b0C</span> | \" +\n    \"<span style='color:\" + (Math.abs(delta_hum) > 10 ? \"#0284c7\" : \"#16a34a\") + \";'>\u0394H: \" + signH + delta_hum + \" %</span> | \" +\n    \"<span style='color:#d97706;'>\u0394P: \" + signP + delta_pres + \" hPa</span>\" +\n    \"</div>\";\n\nreturn [\n    { payload: owm_summary },\n    { payload: delta_card }\n];",
    "outputs": 2,
    "x": 680,
    "y": 760,
    "wires": [
      [
        "ui_owm_summary"
      ],
      [
        "ui_owm_delta"
      ]
    ]
  },
