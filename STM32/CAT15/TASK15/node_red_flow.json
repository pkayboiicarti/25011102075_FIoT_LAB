  {
    "id": "fn_store_bme",
    "type": "function",
    "z": "bme280_tab",
    "name": "Store Sensor State for Cloud Delta",
    "func": "let d = msg.payload;\nif (typeof d === \"string\") {\n    try { d = JSON.parse(d); } catch(e) { return null; }\n}\nif (d && d.temperature !== undefined) {\n    flow.set(\"sensor_data\", {\n        temperature: Number(d.temperature),\n        pressure: Number(d.pressure),\n        humidity: Number(d.humidity),\n        time: new Date().toLocaleTimeString()\n    });\n}\nreturn null;",
    "outputs": 0,
    "x": 510,
    "y": 140,
    "wires": []
  },
